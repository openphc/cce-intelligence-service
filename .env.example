# CCE Intelligence Service (RI-63) — docker-compose environment variables.
# Copy to .env and fill in real values. .env is git-ignored — never commit real credentials.

# Shared Postgres (only needed if collector-service's compose stack uses different values)
DB_HOST=cce-collector-postgres
DB_PORT=5432
DB_NAME=ccedb
DB_USERNAME=cce_user
DB_PASSWORD=cce_pass

# SMTP (Gmail with an App Password works for local testing — see docs/developer-setup.md)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Tier recipients — required, no default (see docs/api-reference.md). Both accept a single
# address or a comma-separated list. For local testing, all three can point at one inbox.
ALERT_EMAIL_TIER1=
ALERT_NAME_TIER1=Patience
ALERT_EMAIL_TIER2=
ALERT_NAME_TIER2=Claudel
ALERT_EMAIL_TIER3=
ALERT_NAME_TIER3=Andrew

# Tier thresholds (minutes) — also required, no default. PRD values shown (4h/24h/48h); change
# only if you deliberately want faster local iteration.
CCE_OPSALERT_TIER1_THRESHOLD_MINUTES=240
CCE_OPSALERT_TIER2_THRESHOLD_MINUTES=1440
CCE_OPSALERT_TIER3_THRESHOLD_MINUTES=2880
